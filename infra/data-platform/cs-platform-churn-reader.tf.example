# =============================================================================
# cs-platform-churn-reader  —  APPLY IN THE DATA PLATFORM ACCOUNT (503561421603)
# =============================================================================
# This is a SEPARATE Terraform stack from infra/ (different account/provider). It
# creates the cross-account role the CS Platform ECS task assumes to read the churn
# model via the Redshift Data API. Rename to cs-platform-churn-reader.tf and apply
# it with Data Platform credentials (e.g. AWS_PROFILE=DataPlatform).
#
# Status (2026-10): the role AND the Redshift SELECT grants were applied IMPERATIVELY this
# session (role created in 503561421603 trusting cs-platform-task; grants via the Data API).
# NDR + live ML churn are flowing (verified: 91% NDR sample, 10,278 churn-scored accounts).
# This stack + the GRANTS runbook below CODIFY that live state so a future Terraform baseline
# does not drift it away. Rename to cs-platform-churn-reader.tf and apply with Data Platform
# credentials (AWS_PROFILE=DataPlatform) to bring it under IaC; it is idempotent with the
# already-created role.
#
# The CS Platform task role ARN comes from the infra/ stack:
#   terraform -chdir=infra output -raw task_role_arn
#   => arn:aws:iam::350067031910:role/cs-platform-task
#
# GRANTS (NOT managed by Terraform — Redshift object grants live in the DB, applied once via
# the Data API as a Data Platform admin; captured here + in GRANTS-RUNBOOK.md):
#   GRANT USAGE ON SCHEMA rpt   TO "IAMR:cs-platform-churn-reader";
#   GRANT SELECT ON TABLE rpt.rpt_account_ndr_monthly        TO "IAMR:cs-platform-churn-reader";
#   GRANT USAGE ON SCHEMA marts TO "IAMR:cs-platform-churn-reader";
#   GRANT SELECT ON TABLE marts.int_ds_account_churn_scoring TO "IAMR:cs-platform-churn-reader";
#   GRANT USAGE ON SCHEMA stg   TO "IAMR:cs-platform-churn-reader";
#   GRANT SELECT ON TABLE stg.stg_jobadder_all_accounts      TO "IAMR:cs-platform-churn-reader";
# (The IAMR:cs-platform-churn-reader DB user is auto-created by Redshift on first assume.)
# =============================================================================

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
  }
}

provider "aws" {
  region              = "ap-southeast-2"
  allowed_account_ids = ["503561421603"] # Data Platform
}

variable "cs_platform_task_role_arn" {
  description = "The CS Platform ECS task role allowed to assume this reader role."
  type        = string
  default     = "arn:aws:iam::350067031910:role/cs-platform-task"
}

variable "redshift_workgroup_arn" {
  description = "ARN of the churn Redshift Serverless workgroup."
  type        = string
  # data-platform-redshift-warehouse-wg-prod. Workgroup id confirmed live 2026-10.
  default = "arn:aws:redshift-serverless:ap-southeast-2:503561421603:workgroup/96c87b2d-6d6d-4003-b919-f5b8d0ee39d0"
}

# Trust policy: only the CS Platform task role may assume this reader.
data "aws_iam_policy_document" "assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "AWS"
      identifiers = [var.cs_platform_task_role_arn]
    }
  }
}

resource "aws_iam_role" "churn_reader" {
  name               = "cs-platform-churn-reader"
  assume_role_policy = data.aws_iam_policy_document.assume.json

  tags = {
    Owner       = "cloud-engineering"
    Repository  = "cs-orchestrator"
    Application = "cs-platform"
    Environment = "prod"
    IaC         = "terraform"
    Lifecycle   = "persistent"
  }
}

# Least-privilege Redshift Data API read for the churn model.
data "aws_iam_policy_document" "churn_read" {
  statement {
    sid = "RedshiftDataApiRead"
    actions = [
      "redshift-data:ExecuteStatement",
      "redshift-data:DescribeStatement",
      "redshift-data:GetStatementResult",
    ]
    resources = ["*"] # Data API actions are not resource-scopable
  }

  statement {
    sid       = "ServerlessGetCredentials"
    actions   = ["redshift-serverless:GetCredentials"]
    resources = [var.redshift_workgroup_arn]
  }
}

resource "aws_iam_role_policy" "churn_read" {
  name   = "cs-platform-churn-read"
  role   = aws_iam_role.churn_reader.id
  policy = data.aws_iam_policy_document.churn_read.json
}

output "churn_reader_role_arn" {
  description = "Set this as REDSHIFT_ASSUME_ROLE_ARN on the CS Platform (already the default in infra/variables.tf)."
  value       = aws_iam_role.churn_reader.arn
}
