# CS Platform — example environment configuration.
# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).
# Only key NAMES appear here; all values are placeholders.

# ─────────────────────────────────────────────────────────────
# Authentication (SSO) — shared JobAdder Okta → Identity Center → Cognito
# ─────────────────────────────────────────────────────────────
# From the ja-observe-api Terraform outputs after applying the cs_platform client:
#   terraform output cs_platform_cognito_client_id
#   terraform output cs_platform_cognito_issuer
#   terraform output -raw cs_platform_cognito_client_secret   (or read from SSM
#     /cs-platform/auth/cognito-client-secret)
AUTH_COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/<userPoolId>
AUTH_COGNITO_ID=<cs_platform_cognito_client_id>
AUTH_COGNITO_SECRET=<cs_platform_cognito_client_secret>
AUTH_COGNITO_DOMAIN=ja-observe-auth         # shared Cognito hosted-UI domain prefix

# Session-cookie signing secret (openssl rand -base64 32). Required in production.
AUTH_SECRET=<random-32+-char-string>

# Public URL of the CS Platform (used to build the OIDC redirect_uri). Must match a
# callback_url on the cs_platform Cognito app client.
CS_PUBLIC_URL=https://cs.jobadder.cloud
# Set behind TLS/Cloudflare so the session cookie uses __Secure-/Secure semantics.
CS_SECURE_COOKIE=1

# Role model (see platform/rbac.py). Admin sees ALL accounts; everyone else is a
# scoped CSM who sees only the accounts they own.
#   CS_ADMIN_GROUPS: dedicated Identity Center CS admin group(s), by ID (preferred)
#                    or display name. Secure by default: unset => no admin group.
CS_ADMIN_GROUPS=<CS-Platform-Admins group id>
#   AUTH_ADMIN_EMAILS: optional break-glass admins (comma-separated), works without
#                      any group. Handy before the Identity Center group exists.
AUTH_ADMIN_EMAILS=

# Local development only: skip Cognito and sign in with any email via a dev form.
# Automatically disabled once AUTH_COGNITO_* is configured.
# AUTH_DEV_LOGIN=1

# ─────────────────────────────────────────────────────────────
# Live data sources (read-only unless noted). See Docs/DATA-ACCESS.md for detail.
# ─────────────────────────────────────────────────────────────
HUBSPOT_TOKEN=
STRIPE_KEY=                     # restricted rk_live_ key (NOT sk_live_)
PENDO_KEY=
CS_PENDO_ACTIVITY=              # "1" to derive API/usage velocity via the Aggregation API
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=
JIMINNY_KEY=

# Entitlements (authoritative license utilization for the >=85% expansion trigger)
ENTITLEMENTS_API_URL=
ENTITLEMENTS_KEY=
# ENTITLEMENTS_ACCOUNT_PATH=/accounts/{account_ref}

# Churn model (Redshift Data API; AWS creds via the standard boto3/AWS_PROFILE chain)
AWS_PROFILE=
AWS_REGION=ap-southeast-2
REDSHIFT_DATABASE=
REDSHIFT_WORKGROUP=
REDSHIFT_CHURN_TABLE=
REDSHIFT_CHURN_MODE=status
# CS_REDSHIFT_POLL_TIMEOUT_S=45   # cold Serverless workgroups can take ~25s on first query

# Write-back (HubSpot health/risk/playbook) — OFF by default.
# CS_ALLOW_WRITE=1
